# Copy to .env for local development. Placeholders and safe local values only.
# Never put real credentials, tokens or production values in this file or in .env.

# Required. One of LOCAL, TEST, STAGING. PRODUCTION is refused by this build.
APP_ENV=LOCAL

# Only SIMULATED is accepted. Practice and live routing do not exist in this build.
BROKER_MODE=SIMULATED

LOG_LEVEL=info

# Loopback port for the execution worker's health endpoint.
WORKER_HEALTH_PORT=4100

# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1

# Phase 2 (not used yet). LOCAL and TEST may only point at a loopback host.
# DATABASE_URL=postgres://tradecopier@localhost:5432/tradecopier_dev

# Broker credentials are refused at startup. Do not add TRADOVATE_*, NINJATRADER_*,
# RITHMIC_*, PROJECTX_*, TOPSTEPX_* or BROKER_* credential variables.
