# Copy to .env for local development. Placeholders and safe local values only.
# Never put real credentials, tokens or production values in this file or in .env.

# Required. One of LOCAL, TEST, STAGING. PRODUCTION is refused by this build.
APP_ENV=LOCAL

# Only SIMULATED is accepted. Practice and live routing do not exist in this build.
BROKER_MODE=SIMULATED

LOG_LEVEL=info

# Loopback port for the execution worker's health endpoint.
WORKER_HEALTH_PORT=4100

# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1

# Broker credentials are refused at startup. Do not add TRADOVATE_*, NINJATRADER_*,
# RITHMIC_*, PROJECTX_*, TOPSTEPX_* or BROKER_* credential variables.

# Local database (Phase 2). `npm run db:bootstrap` creates these roles; generate your own passwords.
# The app connects only as the restricted role. LOCAL/TEST must use a loopback host.
# DATABASE_URL=postgres://tradeplex_app:<generated-local-password>@127.0.0.1:5432/tradeplex_dev

# Migration and integration-test connections belong in .env.db-admin (git-ignored), not here:
# MIGRATION_DATABASE_URL=postgres://tradeplex_migrator:<generated-local-password>@127.0.0.1:5432/tradeplex_dev
# TEST_DATABASE_URL=postgres://tradeplex_app:<generated-local-password>@127.0.0.1:5432/tradeplex_test
# TEST_MIGRATION_DATABASE_URL=postgres://tradeplex_migrator:<generated-local-password>@127.0.0.1:5432/tradeplex_test
